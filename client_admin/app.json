{
  "expo": {
    "name": "NearBy Admin",
    "slug": "nearby-admin",
    "scheme": "nearby-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#171C32",
    "icon": "./assets/images/nearby-logo-original.png",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/nearby-logo-original.png",
        "backgroundColor": "#171C32"
      }
    },
    "web": {
      "favicon": "./assets/images/nearby-logo-original.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "@clerk/expo",
        {
          "appleSignIn": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow NearBy Admin to choose product photos.",
          "microphonePermission": false,
          "cameraPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
