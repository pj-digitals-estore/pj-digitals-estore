{
  "expo": {
    "userInterfaceStyle": "automatic",
    "scheme": "nearby-partner",
    "ios": {
      "supportsTablet": true
    },
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "@clerk/expo",
        {
          "appleSignIn": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow NearBy Shop to choose product photos.",
          "microphonePermission": false,
          "cameraPermission": false
        }
      ]
    ],
    "slug": "nearby-shop",
    "version": "1.0.0",
    "name": "NearBy Shop",
    "icon": "./assets/images/nearby-logo-original.png",
    "web": {
      "favicon": "./assets/images/nearby-logo-original.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/nearby-logo-original.png",
        "backgroundColor": "#171C32"
      }
    }
  }
}
