# Optional in local development; auto-detects the Expo computer on port 3000.
# For a phone, use the server computer's LAN IP, not localhost.
# Set an HTTPS server URL before a production build.
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
EXPO_PUBLIC_API_URL=https://pj-digitals-estore-server.vercel.app

# Online/Razorpay checkout only. Enable after the Razorpay acceptance checks.
# COD uses the orders API directly and is independent of this flag.
EXPO_PUBLIC_ENABLE_LIVE_CHECKOUT=false
EXPO_PUBLIC_SUPPORT_PHONE=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
